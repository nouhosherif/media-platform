# Copy to backend/.env for local development, then generate your own key.
# Do not copy a production key here. Existing environment variables take priority.
# Literal KEY=value only; matching outer quotes and whole-line comments allowed.
# No interpolation, shell commands, escapes, multiline values, or inline comments.
# Select DJANGO_SETTINGS_MODULE in the process environment, never in this file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

# Relative filesystem paths resolve beneath backend/, not the current directory.
DJANGO_SQLITE_PATH=db.sqlite3
DJANGO_MEDIA_ROOT=media
DJANGO_STATIC_ROOT=staticfiles

# Production database (used when DJANGO_DATABASE_ENGINE=postgresql).
DJANGO_DATABASE_ENGINE=sqlite
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=require
DJANGO_DB_CONN_MAX_AGE=60

# Optional production integrations. Leave blank until provisioned and tested.
DJANGO_CACHE_URL=
DJANGO_BACKGROUND_TASK_DISPATCHER=
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
