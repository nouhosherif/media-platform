DJANGO_SETTINGS_MODULE=core.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_DATABASE_ENGINE=postgresql
DJANGO_DB_NAME=media
DJANGO_DB_USER=media
DJANGO_DB_PASSWORD=replace-me
DJANGO_DB_HOST=database
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=disable
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_CACHE_URL=redis://cache:6379/1
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_SECURE_SSL_REDIRECT=false
POSTGRES_DB=media
POSTGRES_USER=media
POSTGRES_PASSWORD=replace-me
