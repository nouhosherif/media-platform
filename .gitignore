# Rules apply to untracked files. Existing tracked data requires separate review.

# Local Python environments and generated bytecode/tool caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# JavaScript dependencies, caches, test/build output
node_modules/
.npm-cache/
coverage/
dist/
dist-ssr/
build/
.expo/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Private environment configuration; keep sanitized examples discoverable
.env
.env.*
!.env.example
!.env.*.example

# Logs and runtime files
logs/
*.log
/backend/db.sqlite3
/backend/db.sqlite3-journal
/backend/db.sqlite3-shm
/backend/db.sqlite3-wal
/backend/media/
/backend/staticfiles/
/backend/backups/

# Private signing material (never use real credentials in fixtures)
*.pem
*.key
*.p12
*.pfx

# OS-generated metadata
.DS_Store
Thumbs.db
Desktop.ini
